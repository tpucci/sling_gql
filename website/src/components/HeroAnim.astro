---
/**
 * Plays public/hero.json inside the `#hero-anim` placeholder declared in the
 * landing page's hero frontmatter. Regenerate the JSON with
 * `python3 scripts/make_hero_lottie.py`.
 */
---

<script>
  import lottie from 'lottie-web/build/player/lottie_light';

  // Bundled scripts run once per visit under Astro's <ClientRouter />: (re)mount on every
  // `astro:page-load` and dispose before the page is swapped out.
  let anim: ReturnType<typeof lottie.loadAnimation> | null = null;

  function unmount() {
    anim?.destroy();
    anim = null;
  }

  function mount() {
    unmount();
    const container = document.getElementById('hero-anim');
    if (!container) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    anim = lottie.loadAnimation({
      container,
      renderer: 'svg',
      loop: true,
      autoplay: !reduce,
      path: `${import.meta.env.BASE_URL}/hero.json`.replace('//', '/'),
    });
    // `#frame=N` freezes the animation on one frame (used for screenshots/debugging).
    const frame = Number(new URLSearchParams(location.hash.slice(1)).get('frame'));
    const still = reduce ? 300 : Number.isFinite(frame) && frame > 0 ? frame : null;
    const current = anim;
    if (still !== null) current.addEventListener('DOMLoaded', () => current.goToAndStop(still, true));
  }

  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', unmount);
</script>
